# Copy this file to apps/api/.env (the API reads that path, not root .env).
# Defaults use fake providers; no model or dataset credentials are needed.
EXTERNAL_MODE=fake
# Relative to the process working directory; start commands from the repo root.
DATABASE_URL=sqlite:///./grounded_tutor.db
# Provider origins below are local placeholders, not hosted credentials.
FASTGPT_BASE_URL=http://localhost:3000
FASTGPT_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
RUN_LIVE_INTEGRATION=0
ENABLE_LOCAL_ADMIN=false
SUPPORTS_IMAGE_FILES=false
# For live setup see docs/fastgpt-generation.md. Never commit apps/api/.env.
